# ==============================================================================
# Variables de Entorno - Cine Teatro Xilotzin PWA (Frontend)
# Copia este archivo a .env.local para desarrollo local
# ==============================================================================

# URL base de la API REST .NET Core (cine-back)
NEXT_PUBLIC_API_URL=http://localhost:5203/api

# (Opcional) Clave de API de The Movie Database (TMDB v3) si se realizan llamadas directas
# Nota: La búsqueda y detalles primarios son intermediados por el backend en /api/cartelera/buscar-tmdb
NEXT_PUBLIC_TMDB_API_KEY=
